class Solution {
public:
    bool isValid(string s) {

        char stack[s.length()];
        int top = -1;

        for (int i = 0; i < s.length(); i++) {
            if (s[i] == '(' || s[i] == '{' || s[i] == '[') {

                top++;
                stack[top] = s[i];

            }

            else {
                if (top == -1) {
                    return false;
                } else if ((stack[top] == '(' && s[i] != ')')
                    || (stack[top] == '[' && s[i] != ']') ||
                        (stack[top] == '{' && s[i] != '}')) {
                        return false;
                    }
                else {
                    top--;
                }
            }
        }
         
        if(top==-1){
            return true;
        }
        else
          return false;
    }
};